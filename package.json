{
  "name": "claude-orchestra",
  "version": "2.0.0",
  "description": "Control plane for a swarm of Claude Code agents: detachable sessions, live agent state from hooks, remote permission approval, and isolated worktree races",
  "main": "server.js",
  "bin": {
    "claude-orchestra": "bin/cli.js"
  },
  "files": [
    "bin/",
    "lib/",
    "hooks/",
    "public/",
    "server.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "serve": "node server.js",
    "dev": "node --watch-path=lib --watch-path=server.js server.js",
    "test": "node --test test/*.test.js",
    "lint": "node --check server.js && node --check bin/cli.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "agents",
    "agent-orchestration",
    "terminal",
    "multiplexer",
    "pty",
    "xterm",
    "websocket",
    "hooks",
    "git-worktree",
    "devtools"
  ],
  "author": "Emmanuel Lion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/emmanuellion/claude-orchestra.git"
  },
  "homepage": "https://github.com/emmanuellion/claude-orchestra",
  "bugs": {
    "url": "https://github.com/emmanuellion/claude-orchestra/issues"
  },
  "type": "commonjs",
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "ws": "^8.20.0"
  }
}
